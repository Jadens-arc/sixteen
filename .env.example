# Canonical origin of the deployment, used for canonical URLs, the sitemap,
# robots.txt, Open Graph tags and JSON-LD. Set this to the custom domain once
# there is one. Falls back to Vercel's production URL, then to localhost.
NEXT_PUBLIC_SITE_URL=

# Optional @handle for Twitter/X card attribution. Omit to leave the tags off.
NEXT_PUBLIC_TWITTER_HANDLE=

# Neon Postgres connection string (pooled). Required.
DATABASE_URL=

# Clerk auth. Both required for sign-in to work; the app builds and boots
# without them, but every route except /, /sign-in, /sign-up and /api/cron
# requires a session once they're set.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# IANA timezone used to resolve "today" for the daily prompt. Defaults to America/New_York.
APP_TIMEZONE=America/New_York

# Which prompt provider to use: anthropic | openai | offline. Defaults to offline when no key is set.
AI_PROVIDER=offline

# API key for the selected provider. Not needed for the offline provider.
AI_API_KEY=

# Model id for the selected provider. Each provider has a sane default when unset.
AI_MODEL=

# Base URL for the openai-compatible provider (Ollama, LM Studio, Groq, etc). Defaults to https://api.openai.com/v1.
AI_BASE_URL=

# Bearer token the cron route requires in its Authorization header. Leave unset in dev to skip the guard.
CRON_SECRET=

# Key that verse bodies are encrypted with in the database. 32 bytes: base64
# from `openssl rand -base64 32`, or 64 hex characters. Optional - with no key
# set, verses are stored as plain text exactly as they were before this
# existed, and verses already stored either way keep opening.
#
# Keep this somewhere you will still have it in a year. A verse encrypted with
# a key that is gone cannot be read by anyone, this app included.
VERSE_ENCRYPTION_KEY=

# The key this deployment used to write with, while rotating to a new one.
# Decrypt-only: verses written under it keep opening, and new writes use
# VERSE_ENCRYPTION_KEY. Drop it once `npm run db:encrypt-verses` has rewritten
# everything under the new key.
VERSE_ENCRYPTION_KEY_PREVIOUS=
